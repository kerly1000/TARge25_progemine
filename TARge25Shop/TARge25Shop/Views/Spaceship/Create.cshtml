@model IEnumerable<TARge25Shop.Models.Spaceship.SpaceshipCreateViewModel>
    

<div>
    <a asp-action="create" asp-controller="spaceship" type="submit" class="btn-primary">Create</a>
</div>

<style>
    .btn-primary {
        display: inline-block;
        background-color: #4A2C20;
        color: #F3E6D0;
        padding: 10px 20px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 15px;
        border: 1px solid #4A2C20;
        transition: all 0.2s ease;
    }
</style>

<div>
    <h1>Spaceships</h1>
</div>
<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <div class="form-group row">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="ShipType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ShipType" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" class="form-control" />
        </div>
    </div>

    <input asp-action="create" asp-controller="spaceship" type="submit" class="btn btn-primary" value="Create" />
    <a asp-action="Index" asp-controller="spaceship" class="btn btn-secondary">Back to List</a>

</form>
